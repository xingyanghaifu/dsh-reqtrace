{
  "name": "dsh-reqtrace",
  "version": "0.1.0",
  "type": "module",
  "description": "Requirement-to-evidence audit for DSH sessions: check what the agent claims against what it actually did.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "audit",
    "requirements",
    "subagent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingyanghaifu/dsh-reqtrace.git"
  },
  "bugs": {
    "url": "https://github.com/xingyanghaifu/dsh-reqtrace/issues"
  },
  "homepage": "https://github.com/xingyanghaifu/dsh-reqtrace#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "audit.js",
    "client.js",
    "config.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  }
}
